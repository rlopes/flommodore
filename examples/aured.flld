; aured.flld — Flommodore Linker Description (Phase 8 §8.5)
;
; Three objects: the app, gfxlib, and fmtlib. bss carries gfxlib's 2 KB
; expansion table and the app's small value buffer, both NOLOAD.

ENTRY start              ; entry point symbol name

SECTION code AT $04100   ; the canonical program load address (D10)
SECTION data AFTER code  ; strings and the register-name table
SECTION bss  AFTER data  ; the pen table and the format buffer — NOLOAD

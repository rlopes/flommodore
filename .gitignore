.zig-cache/
zig-out/
zig-pkg/
/release/
/debug/
/build/
/build-*/
/docgen_tmp/

.DS_Store

# Generated test ROMs (rebuilt by `zig build genroms`); nop_loop.rom stays tracked.
tests/roms/test_*.rom
tests/roms/font.rom

# The built BIOS firmware (rebuilt by `zig build bios`) — a build product,
# reproducible bit-exactly from src/bios/ by the deterministic toolchain.
rom/flommodore.rom

# Built example programs (rebuilt by `zig build examples`).
examples/*.flapp
examples/*.flsym

# The generated note table (rebuilt by `zig build notes`). VFREQ is a phase
# increment, so this is derived from one formula in flsnd — checking it in
# would invite someone to edit the copy instead of the generator.
src/lib/notes.inc
